# Worker secrets. Copy to .dev.vars for local development (`npm run dev`); never commit .dev.vars.
# The Deploy to Cloudflare button reads this file to prompt for secrets at deploy time.
# Full inventory, purpose and rotation: specs/platform.md §16; admin notes in README.md ("Secrets").
#
# Generate each random value with:  openssl rand -base64 32
# Values must be at least 32 bytes. Use different values for every secret and every installation.

# First-run setup token (TDD §6.8). Optional, at least 32 characters. Empty or unset: a one-time token
# is generated on the first visit and written to Workers Logs instead. Ignored after setup; delete it.
SETUP_TOKEN=

# better-auth's secret: signs the session cookie. Required. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# HMAC key for our stored token hashes (enrolment tickets, later invitation and recovery links). Required.
TOKEN_HASH_KEY=
