{
  "name": "officebox",
  "version": "0.1.0",
  "private": true,
  "description": "A self-owned, Cloudflare-native workspace for small teams.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/worker",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @officebox/web && npm run build -w @officebox/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @officebox/shared -w @officebox/web -w @officebox/worker && node --test scripts/ensure-secrets.test.mjs",
    "e2e": "npm run build && npm run e2e -w @officebox/e2e",
    "preflight": "node scripts/preflight.mjs",
    "deploy": "node scripts/preflight.mjs && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:ci": "node scripts/deploy-ci.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "wrangler": "4.162.0"
  }
}
