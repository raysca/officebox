{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Foundation spike (M0d). Throwaway: local checks only. The production probe lives in probe/.
  "name": "officebox-foundation-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat only for the node:crypto scrypt comparison in src/hash.ts.
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "WEBAUTHN_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    // platform §8 "Sign-in attempts, per IP: 5 per minute"
    { "name": "SIGNIN_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // A 10-second window, to check the other supported period.
    { "name": "BURST", "namespace_id": "1002", "simple": { "limit": 3, "period": 10 } }
  ],
  "queues": {
    "producers": [{ "binding": "DELAYED", "queue": "foundation-delayed" }],
    "consumers": [{ "queue": "foundation-delayed", "max_batch_size": 10, "max_batch_timeout": 1 }]
  },
  "vars": {
    "RP_ID": "localhost",
    "RP_ORIGIN": "http://localhost:8787"
  }
}
