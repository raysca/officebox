{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Production probe for the M0d foundation spike. Deploy with `npm run deploy:probe`, check with
  // `npm run check:probe`, remove with `npm run destroy:probe`. Every route requires the PROBE_TOKEN var that
  // probe/deploy.mjs generates, so the public URL can't be used to burn CPU.
  "name": "officebox-foundation-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RL_60", "namespace_id": "910001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_10", "namespace_id": "910002", "simple": { "limit": 3, "period": 10 } }
  ],
  "queues": {
    "producers": [{ "binding": "PROBE_QUEUE", "queue": "officebox-foundation-probe" }],
    "consumers": [{ "queue": "officebox-foundation-probe", "max_batch_size": 10, "max_batch_timeout": 1 }]
  }
}
