{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "officebox-realtime-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatChannel" },
      { "name": "DOCS", "class_name": "DocRoom" },
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "PRESENCE", "class_name": "WorkspacePresence" },
      { "name": "HUDDLES", "class_name": "HuddleRoom" },
      { "name": "FAKE_SFU", "class_name": "FakeSfu" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatChannel", "DocRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["UserHub", "WorkspacePresence"] },
    { "tag": "v3", "new_sqlite_classes": ["HuddleRoom", "FakeSfu"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "officebox-spike",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "PROJECTION_QUEUE", "queue": "message-projection" }],
    "consumers": [
      {
        "queue": "message-projection",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "message-projection-dlq"
      }
    ]
  },
  // Spike only: /dev/* helper routes, and a fake SFU. For the real Realtime SFU set SFU_MODE to "real" and add the
  // secrets REALTIME_APP_ID, REALTIME_APP_SECRET (and optionally TURN_KEY_ID, TURN_KEY_API_TOKEN) in .dev.vars.
  "vars": { "DEV_LOGIN": "1", "SFU_MODE": "fake" }
}
